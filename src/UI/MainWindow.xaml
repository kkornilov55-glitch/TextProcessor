<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа №1: текстовый конвейер" 
        Height="700" Width="950" 
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>

        <!-- Стиль для кнопок операций -->
        <Style x:Key="DefaultButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFC7C7CC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для красной кнопки -->
        <Style x:Key="ExecuteButton" TargetType="Button">
            <Setter Property="Background" Value="#E53935"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C62828"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопки "Показать контракт" -->
        <Style x:Key="ContractButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E53935"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E53935"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFEBEE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для чёрной кнопки -->
        <Style x:Key="UploadButton" TargetType="Button">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- Основное окно -->
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть -->
        <Border Grid.Column="0" 
                Background="White" 
                CornerRadius="12" 
                Padding="15"
                Margin="0,0,10,0" BorderBrush="#FFC7C7CC" BorderThickness="1,1,1,1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Список операций" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Margin="0,0,0,15" HorizontalAlignment="Center"/>
                
                <!-- Кнопки -->
                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <Button Style="{StaticResource DefaultButton}" Content="Нормализация текста" Click="BtnNormalization_Click"/>
                    <Button Style="{StaticResource DefaultButton}" Content="Маскирование" Click="BtnMasking_Click"/>
                    <Button Style="{StaticResource DefaultButton}" Content="Фильтрация строк" Click="BtnFiltering_Click"/>
                    <Button Style="{StaticResource DefaultButton}" Content="WP Калькулятор" Click="BtnWpCalculator_Click"/>
                </StackPanel>
                
                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource UploadButton}" Content="⤴ Загрузить файл" Click="BtnLoadFile_Click"/>
                    <Button Style="{StaticResource DefaultButton}" Content="⤵ Скачать файл" Click="BtnSaveFile_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Правая часть -->
        <Border Grid.Column="1" 
                Background="White" 
                CornerRadius="12" 
                Padding="14"
                BorderThickness="1,1,1,1"
                BorderBrush="#FFC7C7CC">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" 
                           Text="{Binding CurrentOperationTitle}" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Основное окно для текста -->
                <Border Grid.Row="1" CornerRadius="12" BorderBrush="#CCCCCC" BorderThickness="1" Background="White" ClipToBounds="True" Margin="0,0,0,8">
                    <TextBox TextWrapping="Wrap" AcceptsReturn="True" Padding="10" FontSize="14"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent" VerticalAlignment="Stretch" Foreground="Black"/>
                </Border>

                <!-- Поле ключевого слова (видим только при фильтрации) -->
                <Border Grid.Row="2" Margin="0,0,0,8" Visibility="{Binding IsFilteringVisible}">
                    <StackPanel>
                        <TextBlock Text="Ключевое слово для фильтрации:" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   Foreground="#666666" 
                                   Margin="0,0,0,4"/>
                        <Border CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1" Background="#F9F9F9">
                            <TextBox Text="{Binding FilterKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="13" BorderThickness="0" Background="Transparent"
                                     ToolTip="Введите слово для поиска (используется при операции 'Фильтрация строк')"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Выбор типа маски (видим только при маскировании) -->
                <Border Grid.Row="3" Margin="0,0,0,8" Visibility="{Binding IsMaskingOptionsVisible}">
                    <StackPanel>
                        <TextBlock Text="Тип маски для применения:" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   Foreground="#666666" 
                                   Margin="0,0,0,4"/>
                        <ComboBox Text="{Binding SelectedMaskType, UpdateSourceTrigger=PropertyChanged}"
                                  Padding="8,6" 
                                  FontSize="13"
                                  BorderBrush="#CCCCCC"
                                  BorderThickness="1"
                                  IsEditable="True"
                                  IsReadOnly="True">
                            <ComboBoxItem Content="Телефон (10 цифр)"/>
                            <ComboBoxItem Content="СНИЛС (11 цифр)"/>
                            <ComboBoxItem Content="Банковская карта (16 цифр)"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <!-- Ввод Post-условия для WP-->
                <Border Grid.Row="4" Margin="0,0,0,8" Visibility="{Binding IsWpVisible}">
                    <StackPanel>
                        <TextBlock Text="Цель (Post-условие):" FontSize="12" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,4"/>
                        <Border CornerRadius="8" BorderBrush="#1976D2" BorderThickness="1" Background="#E3F2FD">
                            <TextBox Text="{Binding WpPostCondition, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="8,6" FontSize="13" FontFamily="Consolas" 
                                     BorderThickness="0" Background="Transparent" 
                                     ToolTip="Например: max > 100"/>
                        </Border>
                    </StackPanel>
                </Border>
                <!-- Кнопка выполнить -->
                <Button Grid.Row="5" Style="{StaticResource ExecuteButton}" Content="Выполнить" Click="BtnExecute_Click"/>
                
                <!-- 6. Результаты WP -->
                <Border Grid.Row="6" Margin="0,0,0,8" Visibility="{Binding IsWpVisible}">
                    <StackPanel>
                        <TextBlock Text="📋 Пошаговый трейс:" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding WpSteps}" Height="70" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Background="#F5F5F5" Margin="0,0,0,10"/>

                        <TextBlock Text="Итоговое wp (краткая запись):" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding WpPre}" Height="40" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Background="#FFF9C4" Margin="0,0,0,10"/>

                        <TextBlock Text="🔺 Триада Хоара:" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding WpTriad}" Height="60" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Background="#E8F5E9"/>
                    </StackPanel>
                </Border>

                <!-- Статус контракта -->
                <Border Grid.Row="7" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Статус контракта" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <!-- Индикатор Pre -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="35" Height="35" CornerRadius="17" Margin="0,0,10,0">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding PreColor}"/>
                                </Border.Background>
                                <TextBlock Text="✓" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" MaxWidth="400">
                                <TextBlock Text="PRE" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding PreText}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Индикатор Post -->
                        <StackPanel Orientation="Horizontal">
                            <Border Width="35" Height="35" CornerRadius="17" Margin="0,0,10,0">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding PostColor}"/>
                                </Border.Background>
                                <TextBlock Text="✓" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" MaxWidth="400">
                                <TextBlock Text="POST" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding PostText}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 6. Кнопка показать контракт -->
                <Button Grid.Row="8" Style="{StaticResource ContractButton}" Content="Показать контракт" Click="BtnShowContract_Click" Visibility="{Binding IsContractVisible}"/>
            </Grid>
        </Border>
    </Grid>
</Window>