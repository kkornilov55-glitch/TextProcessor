<Window x:Class="UI.ContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка / Контракт операции" 
        Height="500" Width="550" 
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Border Background="White" 
                CornerRadius="10" 
                Padding="20"
                BorderBrush="#FFC7C7CC" 
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Прокручиваемая область с текстом контракта -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                    <StackPanel>

                        <!-- Заголовок -->
                        <TextBlock Text="{Binding Title}" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#333333"
                                   Margin="0,0,0,15"/>

                        <!-- Pre-условие -->
                        <TextBlock Text="Pre (Предусловие):" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="#E53935"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding PreCondition}" 
                                   FontSize="13" 
                                   TextWrapping="Wrap"
                                   Foreground="#333333"
                                   Margin="0,0,0,15"/>

                        <!-- Post-условие -->
                        <TextBlock Text="Post (Постусловие):" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="#4CAF50"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding PostCondition}" 
                                   FontSize="13" 
                                   TextWrapping="Wrap"
                                   Foreground="#333333"
                                   Margin="0,0,0,15"/>

                        <!-- Эффекты -->
                        <TextBlock Text="Эффекты:" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="#333333"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Effects}" 
                                   FontSize="13" 
                                   TextWrapping="Wrap"
                                   Foreground="#333333"
                                   Margin="0,0,0,15"/>

                        <!-- Валидный пример -->
                        <Border Background="#E8F5E9" 
                                CornerRadius="6" 
                                Padding="10" 
                                Margin="0,0,0,10"
                                BorderBrush="#4CAF50" 
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Валидный вход:" 
                                           FontSize="12" 
                                           FontWeight="Bold" 
                                           Foreground="#2E7D32"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding ValidExample}" 
                                           FontSize="12" 
                                           TextWrapping="Wrap"
                                           Foreground="#333333"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>

                        <!-- Невалидный пример -->
                        <Border Background="#FFEBEE" 
                                CornerRadius="6" 
                                Padding="10"
                                BorderBrush="#E53935" 
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Невалидный вход:" 
                                           FontSize="12" 
                                           FontWeight="Bold" 
                                           Foreground="#C62828"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding InvalidExample}" 
                                           FontSize="12" 
                                           TextWrapping="Wrap"
                                           Foreground="#333333"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Кнопка закрытия -->
                <Button Grid.Row="1" 
                        Content="Закрыть" 
                        Width="120" 
                        Height="35"
                        HorizontalAlignment="Center"
                        Background="#E53935"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>
        </Border>
    </Grid>
</Window>